# Placeholder template only. Export values through your shell/service manager.
# No application module automatically reads .env files.
DJANGO_SETTINGS_MODULE=config.settings.development
# Generate: uv run --locked --offline python -c 'import secrets; print(secrets.token_urlsafe(64))'
CODE_ALONG_SECRET_KEY=replace-with-a-generated-secret-at-least-50-characters-long
CODE_ALONG_DEBUG=true
CODE_ALONG_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CODE_ALONG_DB_NAME=code_along
CODE_ALONG_DB_USER=code_along
CODE_ALONG_DB_PASSWORD=replace-with-your-local-database-password
CODE_ALONG_DB_HOST=127.0.0.1
CODE_ALONG_DB_PORT=5432
CODE_ALONG_DB_SSLMODE=disable
