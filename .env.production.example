# Placeholder-only deployment inputs. Copy to a private, ignored file outside
# build contexts. Never reuse development credentials or commit resolved config.
CODE_ALONG_RELEASE=replace-with-reviewed-release-tag
CODE_ALONG_APP_ORIGIN=https://learn.example.com
CODE_ALONG_RUNNER_ORIGIN=https://python.example.net
CODE_ALONG_ALLOWED_HOSTS=learn.example.com,api
# These must be DIFFERENT registrable sites, not app/runner subdomains of one site.
# The conservative validator requires different final two hostname labels.
CODE_ALONG_APP_TLS_DIR=/etc/code-along/tls/app
CODE_ALONG_RUNNER_TLS_DIR=/etc/code-along/tls/runner
# Each directory contains its real fullchain.pem and private privkey.pem.
CODE_ALONG_SECRET_KEY=replace-with-a-unique-random-secret-at-least-50-characters
CODE_ALONG_DB_NAME=code_along
CODE_ALONG_DB_USER=code_along
CODE_ALONG_DB_PASSWORD=replace-with-production-database-password
CODE_ALONG_DB_HOST=postgres.example.com
CODE_ALONG_DB_PORT=5432
CODE_ALONG_DB_CA_FILE=/etc/code-along/postgres-ca.pem
# PostgreSQL 18 with valid hostname/certificate; verify-full cannot be disabled.
# The migration/provisioning role needs the reviewed schema/CREATE ROLE rights.
CODE_ALONG_COLLABORATION_SECRET=replace-with-unique-random-64-character-secret
CODE_ALONG_COLLABORATION_CONTROL_SECRET=replace-with-different-random-64-character-secret
CODE_ALONG_COLLABORATION_DB_PASSWORD=replace-with-restricted-writer-random-password
CODE_ALONG_SMTP_HOST=smtp.example.com
CODE_ALONG_SMTP_PORT=587
CODE_ALONG_SMTP_USER=replace-with-smtp-user
CODE_ALONG_SMTP_PASSWORD=replace-with-smtp-password
CODE_ALONG_FROM_EMAIL=Code Along <noreply@example.com>
